{
  "expo": {
    "name": "budget-mobile",
    "slug": "the-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F1E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.absoluttech.linmuch.budget"
    },
    "android": {
      "package": "com.absoluttech.linmuch.budget",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Budget to use Face ID to protect and unlock your journal."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5A3C",
          "androidMode": "default",
          "androidCollapsedTitle": "Schedule reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Budget to attach selected receipt or payment proof photos to bills.",
          "cameraPermission": "Allow The Budget to take a receipt or payment proof photo."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "linval"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afc1d0c3-3ab9-429d-b8e4-0e2ea171a550"
      }
    },
    "owner": "linmuch"
  }
}
